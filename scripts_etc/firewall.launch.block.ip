#!/bin/bash
# ==============================================================================
# Immediate IP/CIDR Block Action (Root / Hook Executor sudo)
# Usage: firewall.launch.block.ip <target_ip_or_cidr> [cause]
# ==============================================================================

_SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
FW_DIR="${FW_DIR:-$(cd "$(dirname "${_SELF_PATH}")" && pwd)}"
[ -f "${FW_DIR}/firewall.settings" ] && source "${FW_DIR}/firewall.settings"
[ -f "${FW_DIR}/firewall.vault.conf" ] && source "${FW_DIR}/firewall.vault.conf"
source "${FW_DIR}/firewall.tools"

hosts_deny_file="/etc/hosts.deny"

TARGET="${1:-}"
CAUSE="${2:-Confirmed_Threat}"

if [ -z "${TARGET}" ]; then
	echo "Usage: $0 <target_ip_or_cidr> [cause]" >&2
	exit 1
fi

if ! ip addr show 2>/dev/null | grep -wq "${TARGET%/*}"; then
	if command -v cscli >/dev/null 2>&1; then
		timeout 300 /bin/cscli decisions add -i "${TARGET}" --duration 100000h --reason "${CAUSE}" >/dev/null 2>&1 &
	fi
fi

if command -v fail2ban-client >/dev/null 2>&1; then
	/usr/bin/fail2ban-client set sshd unbanip "${TARGET}" 2>/dev/null &
	/usr/bin/fail2ban-client set recidive unbanip "${TARGET}" 2>/dev/null &
fi

if is_ipv4 "${TARGET}" || is_ipv4_net "${TARGET}"; then
	if ! ip addr show 2>/dev/null | grep -wq "${TARGET%/*}"; then
		if is_ipv4 "${TARGET}"; then
			$ROUTE add -host "${TARGET}" reject 2>/dev/null
		fi
		$IPS add "$IPSLISTBADIP" "${TARGET}" -exist 2>/dev/null
		/bin/echo "${TARGET}" | tee -a "${FW_DIR}/firewall.block.ip" >/dev/null &
		kill_active_connections "inet" "${TARGET}"
		if is_ipv4 "${TARGET}"; then
			$ROUTE -n del "${TARGET}" reject 2>/dev/null
		fi
	fi
elif is_ipv6 "${TARGET}"; then
	if ! ip addr show 2>/dev/null | grep -wq "${TARGET}"; then
		$ROUTE -6 add -host "${TARGET}" reject 2>/dev/null
		$IPS add "${IPSLISTBADIP}6" "${TARGET}/48" -exist 2>/dev/null
		/bin/echo "${TARGET}/48" | tee -a "${FW_DIR}/firewall.block.ip6" >/dev/null &
		kill_active_connections "inet6" "${TARGET}"
	fi
	$ROUTE -6 -n del "${TARGET}" reject 2>/dev/null
elif is_ipv6_net "${TARGET}"; then
	if ! ip addr show 2>/dev/null | grep -wq "${TARGET%/*}"; then
		$IPS add "${IPSLISTBADIP}6" "${TARGET}" -exist 2>/dev/null
		/bin/echo "${TARGET}" | tee -a "${FW_DIR}/firewall.block.ip6" >/dev/null &
		kill_active_connections "inet6" "${TARGET}"
	fi
fi

if [ -f "${hosts_deny_file}" ]; then
	$SED -i "\|^ALL: ${TARGET} : DENY|d" "${hosts_deny_file}" 2>/dev/null
fi

wait
exit 0
