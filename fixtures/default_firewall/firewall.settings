dockerNetworkWithAccess=( "isolate" )
dockerAccessBetweenThem=( "traefik;jellyfin_theatre;isolate;tcp;8096" "traefik;prowlarr;ext;tcp;9696" )
IPAutor=()
IPAutorDnatPortTCP=()
