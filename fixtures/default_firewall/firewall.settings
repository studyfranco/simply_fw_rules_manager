blockedCountry="CN,RU"
blockedCountry2=""
WWDockerTCP=( "443,ext,traefik,443" )
openDockerTCP=( "32400,ext,plexmediaserver,32400" )
WWopenPortTCP=()
WWopenPortUDP=()
openPortTCP=()
openPortUDP=()
