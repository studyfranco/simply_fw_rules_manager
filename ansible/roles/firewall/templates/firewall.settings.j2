#! /bin/bash
# ==============================================================================
# Managed by Ansible: Simply Firewall Main Settings
# Permissions: 0600 1128:root (Managed by simply_fw_rules_manager)
# ==============================================================================

source {{ firewall_dir }}/firewall.tools

# Main Outbound Network Interface
mainInter="{{ ansible_default_ipv4.interface | default('eth0') }}"
declare -a INTEROut=("{{ ansible_default_ipv4.interface | default('eth0') }};{{ ansible_default_ipv4.address | default('') }};{{ ansible_default_ipv6.address | default('') }}")

declare -a interfaceToGoOutSide=()
declare -a internInterfaceHaveAccessAsLocal=()
declare -a interfaceLocal=()
declare -A interfaceWithDHCP=()
declare -a interfaceWithNoRules=()

# Docker Networks Policy
declare -a dockerNetworkWithInternetAccess=("{{ docker_net_ext_name }}" "bridge")
declare -a dockerNetworkWithAccess=("{{ docker_net_isolate_name }}" "{{ docker_net_ext_name }}" "bridge")
declare -a dockerAccessBetweenThem=(
  "simply_fw_rules_manager;socket_proxy;{{ docker_net_isolate_name }};tcp;2375"
  "simply_fw_rules_manager;simply_hook_executor;{{ docker_net_isolate_name }};tcp;3000"
  "fail2ban;simply_hook_executor;{{ docker_net_isolate_name }};tcp;3000"
{% if vault_mode == 'local' and (deploy_simply_ip_vault | default(true) | bool) %}
  "simply_ip_vault;simply_hook_executor;{{ docker_net_isolate_name }};tcp;3000"
{% endif %}
{% if vault_mode == 'local' and (deploy_simply_ip_vault | default(true) | bool) and (deploy_simply_ip_sync | default(false) | bool) %}
  "simply_ip_sync;simply_ip_vault;{{ docker_net_isolate_name }};tcp;3000"
  "simply_ip_sync;simply_ip_vault;{{ docker_net_ext_name }};tcp;3000"
{% endif %}
{% if vault_mode == 'local' and (deploy_simply_ip_vault | default(true) | bool) and (deploy_simply_ip_exporter | default(false) | bool) %}
  "simply_ip_exporter;simply_ip_vault;{{ docker_net_isolate_name }};tcp;3000"
  "simply_ip_exporter;simply_ip_vault;{{ docker_net_ext_name }};tcp;3000"
{% endif %}
{% if database_type == 'postgres_container' %}
  "simply_fw_rules_manager;{{ postgres_container_name }};{{ docker_net_isolate_name }};tcp;5432"
  "simply_hook_executor;{{ postgres_container_name }};{{ docker_net_isolate_name }};tcp;5432"
{% if vault_mode == 'local' and (deploy_simply_ip_vault | default(true) | bool) %}
  "simply_ip_vault;{{ postgres_container_name }};{{ docker_net_isolate_name }};tcp;5432"
{% endif %}
{% if deploy_simply_ip_sync | default(false) | bool %}
  "simply_ip_sync;{{ postgres_container_name }};{{ docker_net_isolate_name }};tcp;5432"
{% endif %}
{% if deploy_simply_ip_exporter | default(false) | bool %}
  "simply_ip_exporter;{{ postgres_container_name }};{{ docker_net_isolate_name }};tcp;5432"
{% endif %}
{% endif %}
)

# Trusted Administration IPs
declare -a IPAutor=({{ (operator_whitelist_ips | default([]) + (firewall_trusted_ips | default([]))) | map('quote') | join(' ') }})
declare -a IPAutorDnatPortTCP=()
declare -a IPAutorDnatPortUDP=()
declare -a IPAutorDockerTCP=()
declare -a IPAutorDockerUDP=()

# Local & Internal Ports
declare -a internalOpenPortsTCP=()
declare -a internalOpenPortsUDP=()
declare -a internalRedirectPortTCP=()
declare -a internalRedirectPortUDP=()
declare -a internalDnatPortTCP=()
declare -a internalDnatPortUDP=()
declare -a internalDockerTCP=()
declare -a internalDockerUDP=()

# Country-Restricted (CR) Open Ports via GeoIP
declare -a countryOpenPort="{{ country_open_port_default | default('FR') }}"
{% if ssh_access_mode == 'country_restricted' %}
declare -a openPortTCP=("{{ effective_sshd_port }}")
{% else %}
declare -a openPortTCP=()
{% endif %}
declare -a openPortUDP=()
declare -a redirectPortTCP=()
declare -a redirectPortUDP=()
declare -a dnatPortTCP=()
declare -a dnatPortUDP=()
declare -a dockerTCP=()
declare -a dockerUDP=()

# WW (World Wide) Open Ports
{% if ssh_access_mode == 'worldwide' %}
declare -a WWopenPortTCP=("{{ effective_sshd_port }}")
{% else %}
declare -a WWopenPortTCP=()
{% endif %}
declare -a WWopenPortUDP=()
declare -a WWredirectPortTCP=()
declare -a WWredirectPortUDP=()
declare -a WWdnatPortTCP=()
declare -a WWdnatPortUDP=()
declare -a WWDockerTCP=()
declare -a WWDockerUDP=()

# Outbound Allowed Ports
declare -a openPortsOutSideTCP=("80" "443" "53")
declare -a openPortsOutSideUDP=("53" "123")

# Local Forward / NAT
declare -a localOpenPortsTCP=({% if database_type == 'postgres_external' %}"{{ postgres_external_port }}"{% endif %})
declare -a localOpenPortsUDP=()
declare -a openDockerTCP=()
declare -a openDockerUDP=()

# Blocked Country Codes (GeoIP)
blockedCountry="{{ (firewall_blocked_countries | default([])) | join(',') }}"
blockedCountry2=""
