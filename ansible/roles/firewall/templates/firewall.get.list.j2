#!/bin/bash
# ==============================================================================
# Managed by Ansible: Threat Intelligence & Whitelist Synchronization
# Permissions: 0700 root:root
# ==============================================================================

source {{ firewall_dir }}/firewall.settings
source {{ firewall_dir }}/firewall.tools

{% if effective_exporter_feed_url is defined and effective_exporter_feed_url | length > 0 %}
# Simply IP Exporter Local / Remote Feed (aggregated via simply_ip_sync & simply_ip_vault)
generate_list "{{ effective_exporter_feed_url }}" "local_abuse" &
{% else %}
# Fallback Direct Threat Feeds when Simply IP Exporter is not configured
generate_list "https://raw.githubusercontent.com/stamparm/maltrail/refs/heads/master/data/mass_scanner.txt" "mass_scanner" &
generate_list "https://www.voipbl.org/update/" "voipbl" &
generate_list "https://raw.githubusercontent.com/bitwire-it/ipblocklist/refs/heads/main/inbound.txt" "bitwire" &
generate_list "https://www.stopforumspam.com/downloads/toxic_ip_cidr.txt" "SFS_Toxic" &
generate_list "https://myip.ms/files/blacklist/csf/latest_blacklist.txt" "myip_blacklist" &
generate_list "https://rules.emergingthreats.net/blockrules/compromised-ips.txt" "emergin" &
generate_list "https://lists.blocklist.de/lists/all.txt" "blocklistde" &
generate_list "https://blocklist.greensnow.co/greensnow.txt" "greensnow" &
generate_list "https://danger.rulez.sk/projects/bruteforceblocker/blist.php" "DangerRulez" &
generate_list "https://cinsarmy.com/list/ci-badguys.txt" "cinsarmy" &
generate_list "https://www.spamhaus.org/drop/dropv6.txt" "spamhaus_v6" &
generate_list "https://www.spamhaus.org/drop/drop.txt" "spamhaus_v4" &
generate_list "https://rules.emergingthreats.net/fwrules/emerging-Block-IPs.txt" "emerginIps" &
{% endif %}

{% if effective_whitelist_feed_url is defined and effective_whitelist_feed_url | length > 0 %}
# Simply Whitelist Feed
generate_whitelist "{{ effective_whitelist_feed_url }}" "remote_whitelist" &
{% endif %}

finalize_blocklists

exit 0
