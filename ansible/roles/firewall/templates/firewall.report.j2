#!/bin/bash
# ==============================================================================
# Managed by Ansible: Simply Firewall Reporting to simply_ip_vault
# Permissions: 0700 root:root (Executable by root and hookexecutor via sudo)
# ==============================================================================

source {{ firewall_dir }}/firewall.settings
source {{ firewall_dir }}/firewall.tools

TARGET="$1"
CAUSE="${2:-Manual_Report}"

{% if vault_mode == 'local' %}
_VAULT_IP="$(get_container_ipv4_on_network "simply_ip_vault" "{{ docker_net_ext_name }}")"
[ -z "$_VAULT_IP" ] && _VAULT_IP="$(get_container_ipv4_on_network "simply_ip_vault" "{{ docker_net_isolate_name }}")"
if [ -n "$_VAULT_IP" ]; then
    URL_API="http://${_VAULT_IP}:3000"
else
{% if docker_pin_container_ips | default(true) | bool %}
    URL_API="http://{{ docker_container_ips.simply_ip_vault.ext_ipv4 }}:3000"
{% else %}
    URL_API="{{ effective_vault_host_url | default('http://127.0.0.1:3000') }}"
{% endif %}
fi
{% else %}
URL_API="{{ effective_vault_host_url | default(remote_vault_url) }}"
{% endif %}
USER_KEY="{{ effective_vault_api_key | default('') }}"
SECRET="{{ effective_vault_signing_secret | default('') }}"
GROUP_NAME="{{ vault_group_name }}"

if [ -z "$USER_KEY" ] || [ -z "$SECRET" ]; then
    echo "simply_ip_vault credentials are not yet configured in {{ firewall_dir }}/firewall.report" >&2
    exit 1
fi

if [ -z "$TARGET" ]; then
    echo "Usage: $0 <target_ip> [cause]" >&2
    exit 1
fi

call() {
    local method="$1" path="$2" body="${3:-}"
    local ts
    ts=$(date -u +%s)
    # CANONICAL_V1: real newlines between the four fields, none at the end.
    local sig
    sig=$(printf '%s\n%s\n%s\n%s' "$method" "${path%%\?*}" "$ts" "$body" \
          | openssl dgst -sha256 -hmac "${SECRET}" | sed 's/^.*= //')
    curl --retry 5 --retry-delay 3 --retry-connrefused -sS -X "$method" \
        -H "X-API-Key: ${USER_KEY}" \
        -H "X-Timestamp: $ts" \
        -H "X-Signature-256: sha256=${sig}" \
        ${body:+-H "Content-Type: application/json" -d "$body"} \
        "${URL_API}${path}"
}

if ! ip addr show | grep -wq "${TARGET%/*}"; then
    if is_ipv4 "${TARGET}" || is_ipv6 "${TARGET}" || is_ipv4_net "${TARGET}" || is_ipv6_net "${TARGET}"; then
        PAYLOAD=$(${JQ:-/usr/bin/jq} -nc \
            --arg target "$TARGET" \
            --arg grp "$GROUP_NAME" \
            --arg cause "$CAUSE" \
            '{target_address: $target, group_name: $grp, cause: $cause}')
        call POST /api/ban "$PAYLOAD"
    fi
fi

exit 0
