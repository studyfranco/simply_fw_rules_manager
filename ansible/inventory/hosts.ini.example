# Example Ansible Inventory for simply_* Ecosystem Deployment
# Copy this file to inventory/hosts.ini and adjust for your target servers.

[security_nodes]
# Connect as root with SSH key:
# server1 ansible_host=192.168.1.100 ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_ed25519

# Connect as a sudo user with SSH key:
# server1 ansible_host=192.168.1.100 ansible_user=debian ansible_become=yes ansible_ssh_private_key_file=~/.ssh/id_ed25519

# Connect with password (use ansible-playbook -k -K or specify inline):
# server1 ansible_host=192.168.1.100 ansible_user=debian ansible_become=yes

# Local target for testing on the current machine:
local_server ansible_host=127.0.0.1 ansible_connection=local

[security_nodes:vars]
# You can override group variables here if needed
